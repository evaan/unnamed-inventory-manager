{
    "swagger": "2.0",
    "info": {
        "description": "API backend for managing the Unnamed Inventory Manager, a tool for handling inventory",
        "title": "Unnamed Inventory Manager API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/callback": {
            "get": {
                "description": "Checks the oauth_state cookie, starts a session and sends you back to the frontend",
                "tags": [
                    "Auth"
                ],
                "summary": "Finish logging in with Google",
                "parameters": [
                    {
                        "type": "string",
                        "description": "OAuth state from Google",
                        "name": "state",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authorization code from Google",
                        "name": "code",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "303": {
                        "description": "Redirect to the frontend",
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "Frontend URL"
                            },
                            "Set-Cookie": {
                                "type": "string",
                                "description": "Session cookie, valid for 8 hours"
                            }
                        }
                    },
                    "400": {
                        "description": "Missing code or invalid OAuth state"
                    },
                    "401": {
                        "description": "Invalid Google login or unverified email"
                    },
                    "409": {
                        "description": "User details already in use"
                    },
                    "500": {
                        "description": "Error logging in"
                    }
                }
            }
        },
        "/login": {
            "get": {
                "description": "Saves the login state in a cookie and sends you to Google",
                "tags": [
                    "Auth"
                ],
                "summary": "Log in with Google",
                "responses": {
                    "302": {
                        "description": "Redirect to Google",
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "Google login URL"
                            },
                            "Set-Cookie": {
                                "type": "string",
                                "description": "OAuth state cookie, valid for 10 minutes"
                            }
                        }
                    },
                    "500": {
                        "description": "Error checking session"
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "description": "Deletes your session and clears the session cookie. Available to logged-in users, including disabled users",
                "tags": [
                    "Auth"
                ],
                "summary": "Log out",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Frontend origin, required if Referer is not set",
                        "name": "Origin",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Logged out",
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "Clears the session cookie"
                            }
                        }
                    },
                    "400": {
                        "description": "Missing session cookie"
                    },
                    "401": {
                        "description": "Not logged in"
                    },
                    "403": {
                        "description": "Invalid or missing frontend Origin or Referer"
                    },
                    "500": {
                        "description": "Error logging out"
                    }
                }
            }
        },
        "/permissions": {
            "get": {
                "description": "Uses the session cookie to get your permissions. Must be logged in",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Get your permissions",
                "responses": {
                    "200": {
                        "description": "Current user's permissions",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Not logged in"
                    },
                    "500": {
                        "description": "Error getting permissions"
                    }
                }
            }
        },
        "/permissions/{id}": {
            "get": {
                "description": "Get permissions by user ID. Admin only, using the session cookie",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Get a user's permissions",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User's permissions",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid user ID"
                    },
                    "401": {
                        "description": "Not logged in"
                    },
                    "403": {
                        "description": "Not an administrator"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "Error getting permissions"
                    }
                }
            },
            "put": {
                "description": "Replace the user's permissions, or send an empty list to clear them. Admin only, using the session cookie",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Replace a user's permissions",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "User permissions",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.PutPermissionsRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Frontend origin, required if Referer is not set",
                        "name": "Origin",
                        "in": "header"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Permissions updated"
                    },
                    "400": {
                        "description": "Invalid user ID or request body"
                    },
                    "401": {
                        "description": "Not logged in"
                    },
                    "403": {
                        "description": "Not an administrator or invalid frontend Origin or Referer"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "Error updating permissions"
                    }
                }
            }
        },
        "/users/{id}": {
            "patch": {
                "description": "Disable or enable a user. Admin only, using the session cookie",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Update a user",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "User ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Whether the user is disabled",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.PatchUserRequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Frontend origin, required if Referer is not set",
                        "name": "Origin",
                        "in": "header"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "User updated"
                    },
                    "400": {
                        "description": "Invalid user ID or request body"
                    },
                    "401": {
                        "description": "Not logged in"
                    },
                    "403": {
                        "description": "Not an administrator or invalid frontend Origin or Referer"
                    },
                    "404": {
                        "description": "User not found"
                    },
                    "500": {
                        "description": "Error updating user"
                    }
                }
            }
        },
        "/whoami": {
            "get": {
                "description": "Returns login status and disabled status. Enabled users also receive their name, email and permissions",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Get the current user",
                "responses": {
                    "200": {
                        "description": "Login status and user details",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "disabled": {
                                    "type": "boolean"
                                },
                                "email": {
                                    "type": "string"
                                },
                                "loggedIn": {
                                    "type": "boolean"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "permissions": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error getting current user"
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.PatchUserRequest": {
            "type": "object",
            "required": [
                "disabled"
            ],
            "properties": {
                "disabled": {
                    "type": "boolean"
                }
            }
        },
        "auth.PutPermissionsRequest": {
            "type": "object",
            "required": [
                "permissions"
            ],
            "properties": {
                "permissions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}